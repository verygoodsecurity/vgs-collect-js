{
  "name": "@vgs/collect-js",
  "version": "0.8.0",
  "description": "VGS Collect.js script loading module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/verygoodsecurity/vgs-collect-js"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "tsdx test --coverage --coverageReporters json-summary",
    "lint": "tsdx lint --fix",
    "prepare": "tsdx build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "author": "Anna Kudriasheva",
  "module": "dist/collect-js.esm.js",
  "devDependencies": {
    "@babel/preset-env": "^7.21.4",
    "husky": "^4.3.8",
    "tsdx": "^0.14.1",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "core-js": "^3.30.0",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "@babel/preset-env": {
      "@babel/plugin-transform-modules-systemjs": "7.29.4"
    },
    "tsdx": {
      "js-yaml": "3.15.2",
      "qs": "6.5.3",
      "babel-plugin-polyfill-regenerator": "0.5.3",
      "rollup": "2.80.0",
      "micromatch": "4.0.8"
    }
  }
}
